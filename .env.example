# Public Supabase credentials (browser-safe publishable / anon key only).
# Prefer sb_publishable_... ; legacy anon JWT also works.
# Leave empty to use local published fallback data.
# Never put sb_secret_... or service_role keys in this frontend app.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional WhatsApp override (international digits only, no + or spaces).
# Default is set in src/config/contact.ts. Example: 2347070296633
VITE_WHATSAPP_NUMBER=
